      "last_verified": "2026-09-16"
    }
  },
  {
    "category": "payment_verification",
    "channel": "email",
    "target_risk_surface": "financial_access",
    "source": "FBI Business Email Compromise PSA",
    "content": "Verify any new or changed payment instruction through a trusted contact method already on file. Do not use a telephone number or reply address supplied only in the change request.",
    "metadata": {
      "record_id": "TRN-005",
      "source": "FBI Business Email Compromise PSA",
      "url": "https://www.ic3.gov/PSA/2023/PSA230609",
      "framework": "FBI",
      "level": "intermediate",
      "source_type": "authoritative_public_guidance",
