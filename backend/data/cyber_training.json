  },
  {
    "category": "otp_protection",
    "channel": "voice_phone",
    "target_risk_surface": "identity_and_sso",
    "source": "NIST SP 800-63B-4",
    "content": "Never disclose a one-time authenticator output to a caller or message sender. Manually entered OTP values can be relayed by an impostor and are not phishing-resistant.",
    "metadata": {
      "record_id": "TRN-011",
      "source": "NIST SP 800-63B-4",
      "url": "https://pages.nist.gov/800-63-4/sp800-63b.html",
      "framework": "NIST",
      "level": "intermediate",
      "source_type": "authoritative_public_guidance",
