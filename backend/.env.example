# Copy to backend/.env for local development. Never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
OPENAI_API_KEY=replace-with-openai-api-key

# Generate a random value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Enables only the named classroom demo accounts in auth_routes.py.
# Keep false for normal Supabase-backed use.
CYBERGUARD_DEMO_MODE=false
